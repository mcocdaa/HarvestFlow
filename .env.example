# ============================================
# HarvestFlow 环境配置
# 复制为 .env 后按需修改：cp .env.example .env
# Docker 部署只需关心「外部端口 / 鉴权 / 监控目录」几项
# ============================================

# --------------------------------------------
# 常用配置
# --------------------------------------------
# Docker 对外端口（浏览器访问地址）
BACKEND_EXTERNAL_PORT=3001
FRONTEND_EXTERNAL_PORT=8001

# 本地源码模式的后端监听地址与端口
HOST=0.0.0.0
PORT=3000

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# API 鉴权密钥（留空则关闭鉴权）
# 前端需同步配置 VITE_API_KEY 并重新构建前端（docker compose up -d --build）
HARVESTFLOW_API_KEY=
VITE_API_KEY=

# 监控文件夹列表，逗号分隔；Docker 中为容器内路径（如 /app/data/inbox）
WATCH_FOLDERS=

# OpenClaw 采集器数据目录（目录结构：<agents_dir>/<agent_id>/sessions/*.jsonl）
# 本地开发填 ./backend/data/test_sessions/agents；留空则 Docker 使用 /app/data/test_sessions/agents
OPENCLAW_AGENTS_DIR=

# --------------------------------------------
# 高级配置（一般无需修改）
# --------------------------------------------
# 本地源码模式的数据目录 / 数据库 / 插件目录（Docker 内部固定为 /app/*）
DATA_DIR=./backend/data
DB_PATH=./backend/data/db/harvestflow.db
PLUGINS_DIR=./plugins

# API 版本前缀（默认 v1）
API_VERSION=v1

# CORS 允许来源，逗号分隔（* 表示允许全部）
CORS_ORIGINS=*

# 密钥定义文件
SECRETS_YAML=./secrets/backend.yaml

# 自动审核：开关与自动通过阈值（评分 >= 阈值自动 approved）
CURATOR_ENABLED=true
AUTO_APPROVE_THRESHOLD=4

# 导出：默认格式（sharegpt/alpaca）与输出目录（留空使用 DATA_DIR/export）
EXPORT_DEFAULT_FORMAT=sharegpt
EXPORT_OUTPUT_DIR=

# 前端 API 地址：留空走同源代理（Docker Nginx /api、本地 Vite /api）
# 仅当前端需直连独立后端时填写，如 http://localhost:3001
VITE_API_BASE_URL=
